# Создайте отдельный проект Supabase для DOOR CONFIG.
# Скопируйте этот файл в .env.local и заполните только публичные параметры.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# По умолчанию форма заявок скрыта. Включайте только вместе с DOOR_REQUESTS_ENABLED на сервере.
VITE_DOOR_REQUESTS_ENABLED=false
